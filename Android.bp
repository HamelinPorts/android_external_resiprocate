// reSIProcate — Android/Soong build, pinned at upstream tag resiprocate-1.13.2.
// License: Vovida Software License v1.0 (Apache-1.1-derived, permissive).
// Consumed by packages/apps/HamelinPortsImsService via JNI.

package {
    default_applicable_licenses: ["external_resiprocate_license"],
}

license {
    name: "external_resiprocate_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-BSD",
    ],
    license_text: ["LICENSE.md"],
}

// ---------------------------------------------------------------------------
// rutil — utility library (threads, DNS via c-ares, logging, parser helpers)
// ---------------------------------------------------------------------------

cc_library_static {
    name: "libresip_rutil",
    vendor_available: true,

    srcs: [
        "rutil/*.cxx",
        "rutil/dns/*.cxx",
        "rutil/stun/*.cxx",
        "rutil/hep/*.cxx",
        "rutil/ssl/*.cxx",
    ],

    exclude_srcs: [
        "rutil/WinCompat.cxx",
        "rutil/Plugin.cxx",
        "rutil/ProtonThreadBase.cxx",
        "rutil/PyExtensionBase.cxx",
        // LocalDns is the bundled fallback resolver; never used when
        // USE_CARES is set. Its ares_query callback signature is also
        // out of date versus c-ares 1.34.x.
        "rutil/dns/LocalDns.cxx",
    ],

    local_include_dirs: [
        "android",
        ".",
    ],

    export_include_dirs: ["."],

    cflags: [
        "-DHAVE_CONFIG_H",
        "-D_RESIP_MONOTONIC_CLOCK",
        "-DUSE_IPV6",
        "-DUSE_SSL",
        "-DUSE_CARES",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-deprecated-declarations",
        "-Wno-implicit-fallthrough",
        "-Wno-overloaded-virtual",
        // Upstream has many classes with virtual methods but non-virtual
        // dtors (none are polymorphically deleted). AOSP's default flags
        // make this an error; demote to warning.
        "-Wno-error=non-virtual-dtor",
        "-Wno-non-virtual-dtor",
        // Upstream decorates some by-value return types with `const` —
        // a no-op the compiler flags.
        "-Wno-ignored-qualifiers",
        // Upstream has some maybe-uninitialized paths that the compiler
        // can't prove are guarded by earlier checks.
        "-Wno-sometimes-uninitialized",
        "-Wno-uninitialized",
        // SipMessage.cxx deliberately does `return *(T*)0` after
        // resip_assert(false) as an unreachable placeholder.
        "-Wno-error=null-dereference",
        "-Wno-null-dereference",
    ],

    cppflags: [
        "-std=gnu++17",
        "-fexceptions",
    ],

    rtti: true,

    static_libs: [
        "libcares",
    ],

    shared_libs: [
        "libssl",
        "libcrypto",
    ],
}

// ---------------------------------------------------------------------------
// resip/stack — the SIP parser/transport stack
// ---------------------------------------------------------------------------

cc_library_static {
    name: "libresip_stack",
    vendor_available: true,

    srcs: [
        "resip/stack/*.cxx",
        "resip/stack/gen/*.cxx",
        "resip/stack/ssl/*.cxx",
    ],

    exclude_srcs: [
        // Platform-specific security providers; not applicable to Android.
        "resip/stack/ssl/MacSecurity.cxx",
        "resip/stack/ssl/WinSecurity.cxx",
        // Self-signed cert generator. Uses RSA_generate_key +
        // X509V3_EXT_conf_nid which AOSP's BoringSSL does not export.
        // Not on our VoLTE/IPsec path; exclude.
        "resip/stack/makeCert.cxx",
    ],

    local_include_dirs: [
        "android",
        ".",
    ],

    export_include_dirs: ["."],

    cflags: [
        "-DHAVE_CONFIG_H",
        "-D_RESIP_MONOTONIC_CLOCK",
        "-DUSE_IPV6",
        "-DUSE_SSL",
        "-DUSE_CARES",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-deprecated-declarations",
        "-Wno-implicit-fallthrough",
        "-Wno-overloaded-virtual",
        // Upstream has many classes with virtual methods but non-virtual
        // dtors (none are polymorphically deleted). AOSP's default flags
        // make this an error; demote to warning.
        "-Wno-error=non-virtual-dtor",
        "-Wno-non-virtual-dtor",
        // Upstream decorates some by-value return types with `const` —
        // a no-op the compiler flags.
        "-Wno-ignored-qualifiers",
        // Upstream has some maybe-uninitialized paths that the compiler
        // can't prove are guarded by earlier checks.
        "-Wno-sometimes-uninitialized",
        "-Wno-uninitialized",
        // SipMessage.cxx deliberately does `return *(T*)0` after
        // resip_assert(false) as an unreachable placeholder.
        "-Wno-error=null-dereference",
        "-Wno-null-dereference",
    ],

    cppflags: [
        "-std=gnu++17",
        "-fexceptions",
    ],

    rtti: true,

    whole_static_libs: ["libresip_rutil"],
    static_libs: ["libcares"],
    shared_libs: ["libssl", "libcrypto"],
}

// ---------------------------------------------------------------------------
// resip/dum — Dialog Usage Manager (sits on top of the SIP stack)
// ---------------------------------------------------------------------------

cc_library_static {
    name: "libresip_dum",
    vendor_available: true,

    srcs: [
        "resip/dum/*.cxx",
        "resip/dum/ssl/*.cxx",
    ],

    local_include_dirs: [
        "android",
        ".",
    ],

    export_include_dirs: ["."],

    cflags: [
        "-DHAVE_CONFIG_H",
        "-D_RESIP_MONOTONIC_CLOCK",
        "-DUSE_IPV6",
        "-DUSE_SSL",
        "-DUSE_CARES",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-deprecated-declarations",
        "-Wno-implicit-fallthrough",
        "-Wno-overloaded-virtual",
        // Upstream has many classes with virtual methods but non-virtual
        // dtors (none are polymorphically deleted). AOSP's default flags
        // make this an error; demote to warning.
        "-Wno-error=non-virtual-dtor",
        "-Wno-non-virtual-dtor",
        // Upstream decorates some by-value return types with `const` —
        // a no-op the compiler flags.
        "-Wno-ignored-qualifiers",
        // Upstream has some maybe-uninitialized paths that the compiler
        // can't prove are guarded by earlier checks.
        "-Wno-sometimes-uninitialized",
        "-Wno-uninitialized",
        // SipMessage.cxx deliberately does `return *(T*)0` after
        // resip_assert(false) as an unreachable placeholder.
        "-Wno-error=null-dereference",
        "-Wno-null-dereference",
    ],

    cppflags: [
        "-std=gnu++17",
        "-fexceptions",
    ],

    rtti: true,

    whole_static_libs: ["libresip_stack"],
    static_libs: ["libcares"],
    shared_libs: ["libssl", "libcrypto"],
}
